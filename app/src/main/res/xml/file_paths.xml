<paths>
    <!-- Where a downloaded update APK is staged before the installer reads it. -->
    <cache-path
        name="updates"
        path="updates/" />

    <!-- The assistant's workspace, shared with a viewer when it opens a file. -->
    <files-path
        name="workspace"
        path="workspace/" />
</paths>
