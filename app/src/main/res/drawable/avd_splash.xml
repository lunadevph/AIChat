<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="100dp"
            android:height="100dp"
            android:viewportWidth="24"
            android:viewportHeight="24">

            <group
                android:name="intro_group"
                android:pivotX="12"
                android:pivotY="12">
                <group
                    android:name="pulse_group"
                    android:pivotX="12"
                    android:pivotY="12">
                    <!-- AUTO AWESOME SPARK (Rounded) -->
                    <path
                        android:name="spark"
                        android:fillColor="#FFFFFF"
                        android:fillAlpha="0"
                        android:pathData="M19.46 8l.79-1.75L22 5.46a.5.5 0 0 0 0-.91l-1.75-.79L19.46 2a.5.5 0 0 0-.91 0l-.79 1.75l-1.76.79a.5.5 0 0 0 0 .91l1.75.79l.79 1.76c.18.39.74.39.92 0zM11.5 9.5L9.91 6c-.35-.78-1.47-.78-1.82 0L6.5 9.5L3 11.09c-.78.36-.78 1.47 0 1.82l3.5 1.59L8.09 18c.36.78 1.47.78 1.82 0l1.59-3.5l3.5-1.59c.78-.36.78-1.47 0-1.82L11.5 9.5zm7.04 6.5l-.79 1.75l-1.75.79a.5.5 0 0 0 0 .91l1.75.79l.79 1.76a.5.5 0 0 0 .91 0l.79-1.75l1.76-.79a.5.5 0 0 0 0-.91l-1.75-.79l-.79-1.76a.508.508 0 0 0-.92 0z"/>
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- BOUNCY POP (overshoot) -->
    <target android:name="intro_group">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="800"
                android:valueFrom="0"
                android:valueTo="0.5"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/overshoot"/>
        </aapt:attr>
    </target>

    <target android:name="intro_group">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="800"
                android:valueFrom="0"
                android:valueTo="0.5"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/overshoot"/>
        </aapt:attr>
    </target>

    <!-- SETTLE SPIN -->
    <target android:name="intro_group">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:duration="900"
                android:valueFrom="-120"
                android:valueTo="0"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </aapt:attr>
    </target>

    <!-- FADE IN -->
    <target android:name="spark">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:duration="350"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </aapt:attr>
    </target>

    <!-- GENTLE SHIMMER PULSE (continuous) -->
    <target android:name="pulse_group">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="700"
                android:valueFrom="1"
                android:valueTo="1.1"
                android:valueType="floatType"
                android:startOffset="700"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate"/>
        </aapt:attr>
    </target>

    <target android:name="pulse_group">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="700"
                android:valueFrom="1"
                android:valueTo="1.1"
                android:valueType="floatType"
                android:startOffset="700"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate"/>
        </aapt:attr>
    </target>

</animated-vector>
